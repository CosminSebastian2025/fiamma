{
  "expo": {
    "name": "Fiamma",
    "slug": "fiamma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fiamma",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0C11",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fiamma.app"
    },
    "android": {
      "package": "com.fiamma.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0C11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fiamma accede alle tue foto solo per creare il profilo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fiamma usa la posizione per mostrarti persone vicine. Le coordinate esatte non sono mai visibili agli altri utenti."
        }
      ],
      "expo-font"
    ]
  }
}
